# Copy to backend/.env for local development (never commit the real .env).

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection. Local example:
DATABASE_URL=postgres://icrm:password@localhost:5432/icrm
# Set to true only when connecting over the internet (e.g. Render's EXTERNAL
# database URL). Render's internal URL and a local database need no SSL.
DATABASE_SSL=false

# --- Files -------------------------------------------------------------------
# Folder for uploaded files. Must be on a persistent disk in production.
DATA_DIR=./data

# --- Server ------------------------------------------------------------------
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRM_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
CRM_TIMEZONE=Asia/Kolkata

# --- Optional ----------------------------------------------------------------
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
# ANTHROPIC_API_KEY=
